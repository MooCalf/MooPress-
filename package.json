{
  "name": "moopress",
  "productName": "MooPress",
  "version": "0.1.0",
  "description": "A word processor built for book authors.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,app \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/electron.cjs\"",
    "build": "vite build",
    "start": "vite build && node scripts/electron.cjs",
    "clean": "node scripts/clean.cjs",
    "dist": "npm run clean && npm run icons && vite build && electron-builder --win",
    "icons": "node scripts/electron.cjs scripts/make-icons.cjs",
    "register-files": "powershell -ExecutionPolicy Bypass -File scripts/register-file-types.ps1",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@turbodocx/html-to-docx": "^1.23.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^4.10.38",
    "turndown": "^7.2.4",
    "word-extractor": "^1.0.4",
    "wordnet-db": "^3.1.14"
  },
  "devDependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-text-style": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dictionary-en": "^4.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "jszip": "^3.10.2",
    "lucide": "^1.61.0",
    "nspell": "^2.1.5",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "author": "MooCalf",
  "build": {
    "appId": "com.moocalf.moopress",
    "productName": "MooPress",
    "executableName": "MooPress",
    "copyright": "Copyright © 2026 MooCalf",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json",
      "!node_modules/@napi-rs/**",
      "!node_modules/pdfjs-dist/build/**",
      "!node_modules/pdfjs-dist/web/**",
      "!node_modules/pdfjs-dist/types/**",
      "!node_modules/pdfjs-dist/image_decoders/**",
      "!node_modules/pdfjs-dist/standard_fonts/**",
      "!node_modules/pdfjs-dist/legacy/web/**",
      "!node_modules/pdfjs-dist/legacy/image_decoders/**",
      "!node_modules/pdfjs-dist/legacy/build/*.map",
      "!node_modules/pdfjs-dist/legacy/build/*.min.mjs",
      "!node_modules/pdfjs-dist/legacy/build/pdf.sandbox*",
      "!node_modules/pdfjs-dist/legacy/build/*.d.mts",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.md",
      "!**/test/**",
      "!**/tests/**"
    ],
    "asarUnpack": [
      "node_modules/wordnet-db/**",
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh"
    },
    "fileAssociations": [
      {
        "ext": "moopress",
        "name": "MooPress Book",
        "description": "MooPress Book",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  }
}
